{
    "etrade_api": {
        "config_template": {
            "etrade": {
                "consumer_key": "YOUR_CONSUMER_KEY",
                "consumer_secret": "YOUR_CONSUMER_SECRET",
                "sandbox": false
            }
        },
        "setup_steps": [
            "1. Create config.json in project root with the above template",
            "2. Replace YOUR_CONSUMER_KEY and YOUR_CONSUMER_SECRET with your E*TRADE API credentials",
            "3. Set sandbox to true for testing, false for production"
        ],
        "verification_flow": [
            "1. When running the app first time, it will open E*TRADE login page",
            "2. Login with your E*TRADE credentials",
            "3. Copy the verification code from E*TRADE page",
            "4. Create verification_code.txt in project root",
            "5. Paste the verification code into verification_code.txt"
        ],
        "security_rules": [
            "1. Never commit config.json to version control",
            "2. Never commit verification_code.txt to version control",
            "3. Add both files to .gitignore",
            "4. Use environment variables for production deployment"
        ],
        "required_files": [
            {
                "path": "config.json",
                "description": "Contains E*TRADE API credentials",
                "location": "project root",
                "is_sensitive": true
            },
            {
                "path": "verification_code.txt",
                "description": "Temporary file for E*TRADE verification code",
                "location": "project root",
                "is_sensitive": true,
                "is_temporary": true
            }
        ],
        "usage_example": {
            "python": [
                "from pyetrade import ETradeAPI",
                "import json",
                "",
                "# Load config",
                "with open('config.json', 'r') as f:",
                "    config = json.load(f)",
                "",
                "# Initialize API",
                "api = ETradeAPI(",
                "    consumer_key=config['etrade']['consumer_key'],",
                "    consumer_secret=config['etrade']['consumer_secret'],",
                "    sandbox=config['etrade']['sandbox']",
                ")",
                "",
                "# First time authentication",
                "if not api.is_authenticated():",
                "    api.authenticate()",
                "    # At this point, browser will open for login",
                "    # After login, read verification code",
                "    with open('verification_code.txt', 'r') as f:",
                "        verification_code = f.read().strip()",
                "    api.verify_code(verification_code)",
                "",
                "# Now you can use the API",
                "quotes = api.get_quote(['AAPL', 'GOOGL'])"
            ]
        },
        "common_operations": {
            "get_quotes": "api.get_quote(['AAPL', 'GOOGL'])",
            "get_option_chains": "api.get_option_chains('AAPL')",
            "place_order": "api.place_equity_order(...)",
            "get_account_balance": "api.get_account_balance()"
        }
    }
} 